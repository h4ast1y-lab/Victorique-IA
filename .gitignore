# =============================================================================
# .gitignore - Victorique-IA
# Projeto Python / IA (PyTorch, áudio/voz)
# =============================================================================

# --- Ambientes virtuais Python (NÃO subir ao GitHub) ---
.venv/
.venv-voice/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Bytecode e arquivos compilados Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/parts/
/lib/
/lib64/
/sdist/
/var/
/wheels/
/share/
/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- IDEs e editores de código ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Sistema operacional ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*.ipynb
.checkpoint/

# --- Testes e cobertura ---
.pytest_cache/
.coverage
coverage.xml
coverage.html/
htmlcov/
.tox/
.nox/

# --- Logs ---
*.log
/logs/

# --- IA / Machine Learning - modelos e dados (grandes, não versionar) ---
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.gguf
*.h5
*.npz
*.npy
*.zip
*.tar.gz
*.rar
*.7z
/data/
/datasets/
/models/
/checkpoints/
/outputs/
/runs/
/mlruns/
.wandb/

# --- Arquivos temporários ---
*.tmp
*.temp
*.bak

# --- Variáveis de ambiente / secrets ---
.env
.env.*
!.env.example

# --- Específicos do Victorique ---
# Configuração local do Claude Code e registros de sessão
.claude/
.superpowers/
# Launcher gerado (scripts/build_launcher.py)
/Victorique.exe

# --- Sprites novos (imagens geradas e saídas intermediárias) ---
sprites_novos/gerado/
sprites_novos/pronto/
sprites_novos/debug/
